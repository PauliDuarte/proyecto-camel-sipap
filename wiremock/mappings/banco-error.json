{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/bancos/(itau|atlas|familiar)/transferencias",
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.numeroCuenta", "equalTo": "999999" } }
    ]
  },
  "response": {
    "status": 500,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "idTransaccion": "{{request.headers.X-Transaction-Id}}",
      "estado": "ERROR_BANCO",
      "mensaje": "Error técnico del banco simulado"
    },
    "transformers": ["response-template"]
  }
}
